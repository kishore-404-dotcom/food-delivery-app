# Application Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Optional comma-separated list of additional trusted frontend origins.
FRONTEND_URLS=

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/food-delivery

# JWT Authentication Secret
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Redis cache (optional; requests continue without cache when unavailable)
REDIS_URL=redis://localhost:6379

# Razorpay Payments
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SMTP Email
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password

# HTTPS email provider for hosts that block SMTP (recommended on Render Free)
# Create these in Brevo and keep the API key only in the backend environment.
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=Foodie <your-verified-sender@example.com>
